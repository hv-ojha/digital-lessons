# Supabase Configuration
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ====================
# AI Model Configuration
# ====================

# Primary AI Provider (gemini, openai, anthropic)
AI_PROVIDER=gemini

# Model name for lesson generation
# Gemini: gemini-2.5-flash, gemini-2.5-pro
# OpenAI: gpt-4, gpt-3.5-turbo
AI_MODEL_NAME=gemini-2.5-flash

# Optional: Specific model for title generation
# If not set, uses AI_MODEL_NAME
AI_TITLE_MODEL=gemini-2.5-flash

# Optional: Specific model for image generation
AI_IMAGE_MODEL=gemini-2.5-flash-image

# Optional: Override temperature (0.0-1.0)
# AI_TEMPERATURE=0.3

# Optional: Override max tokens (default: 32768)
# Use higher values for very complex lessons with lots of content
# AI_MAX_TOKENS=32768

# ====================
# Feature Flags
# ====================

# Enable/disable AI image generation for lessons
# When false: Images won't be generated, saving time and API costs
# When true: AI will generate images for visual lessons
ENABLE_IMAGE_GENERATION=false

# Enable/disable prompt caching for Gemini API
# NOTE: Currently disabled - requires Vertex AI API or SDK v2.0+ with caching support
# When implemented: System prompts will be cached, saving ~90% on input tokens
# Current status: false (not yet implemented)
ENABLE_PROMPT_CACHING=false

# ====================
# API Keys
# ====================

# Google Gemini API Key for lesson generation
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI API Key (if using OpenAI provider)
# Get your API key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API Key (if using Anthropic provider)
# Get your API key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ====================
# LangSmith Tracing (RECOMMENDED for debugging)
# ====================

# Enable LangSmith tracing to debug AI calls
# When enabled: All AI calls are traced in LangSmith dashboard
# When disabled: AI calls work normally without tracing
# Get your API key from: https://smith.langchain.com/settings

# Set to "true" to enable tracing (recommended for debugging deployment issues)
LANGCHAIN_TRACING_V2=false

# Your LangSmith API key (required if LANGCHAIN_TRACING_V2=true)
# LANGSMITH_API_KEY=your-langsmith-api-key

# Project name in LangSmith (optional, defaults to "default")
# LANGSMITH_PROJECT=digital-lessons

# LangSmith API endpoint (optional, uses default)
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ====================
# Inngest (Background Job Processing)
# ====================

# Inngest Event Key for background job processing
# Get your key from: https://www.inngest.com/docs/getting-started
# Leave empty for local development (uses dev server)
# Required for production deployment
# INNGEST_EVENT_KEY=your-inngest-event-key

# Inngest Signing Key (optional, for webhook verification)
# INNGEST_SIGNING_KEY=your-inngest-signing-key
