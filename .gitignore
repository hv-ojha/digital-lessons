# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ========================================
# 🔒 SECURITY: Environment Variables & API Keys
# ========================================
# NEVER commit these files - they contain sensitive API keys
.env
.env.local
.env*.local
.env.development
.env.test
.env.production
.env.development.local
.env.test.local
.env.production.local

# Additional security files
*.key
*.pem
*.cert
*.p12
secrets.*
credentials.*

# ========================================
# Dependencies
# ========================================
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ========================================
# Testing
# ========================================
/coverage
*.lcov

# ========================================
# Next.js
# ========================================
/.next/
/out/
.next

# ========================================
# Production
# ========================================
/build
/dist

# ========================================
# Logs
# ========================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ========================================
# Operating System
# ========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini

# ========================================
# IDEs & Editors
# ========================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ========================================
# Vercel
# ========================================
.vercel

# ========================================
# TypeScript
# ========================================
*.tsbuildinfo
next-env.d.ts

# ========================================
